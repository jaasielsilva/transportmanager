# Molde do kit — copiar para .env.example na raiz (ESTE arquivo vai para o git;
# o .env real, nunca). Em producao o .env e gerado pelo setup-vps.sh.

# --- Deploy / imagem ---
IMAGE_TAG=latest              # em producao vira sha-<commit>; alias so no 1o deploy
SPRING_PROFILE=prod           # dev | homolog | prod
FRONTEND_PORT=8081            # 8081 prod | 8082 homolog
DB_PORT_HOST=3306             # 3306 prod | 3307 homolog (nao podem colidir)

# --- Banco ---
DB_NAME=nome_do_banco
DB_USER=nome_user
DB_PASSWORD=                  # openssl rand -base64 32
DB_ROOT_PASSWORD=             # openssl rand -base64 32

# --- Seguranca ---
JWT_SECRET=                   # openssl rand -base64 64
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br

# --- Aplicacao ---
APP_BASE_URL=https://app.exemplo.com.br

# --- E-mail transacional (convite, reset de senha, dunning) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@exemplo.com.br

# --- Billing (gateway externo — nunca dado de cartao no nosso banco) ---
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=       # valida a assinatura do webhook recebido
